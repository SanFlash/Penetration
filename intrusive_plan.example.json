{
  "mode": "controlled-destructive-v1",
  "destructive_ack": "I_UNDERSTAND_CONTROLLED_DATA_CHANGE",
  "target_origin": "https://amwebtech.com",
  "operations": [
    {
      "name": "create-and-delete-disposable-record",
      "method": "POST",
      "url": "/REPLACE_WITH_TEST_CREATE_ENDPOINT",
      "disposable_resource": true,
      "json": {
        "name": "sentinel-intrusive-test-{run_id}"
      },
      "id_path": "id",
      "rollback": {
        "method": "DELETE",
        "url": "/REPLACE_WITH_TEST_RESOURCE/{resource_id}"
      }
    },
    {
      "name": "update-and-restore-disposable-record",
      "method": "PATCH",
      "url": "/REPLACE_WITH_TEST_RESOURCE/{resource_id}",
      "disposable_resource": true,
      "json": {
        "name": "sentinel-intrusive-mutated-{run_id}"
      },
      "restore_json": {
        "name": "sentinel-intrusive-test-{run_id}"
      },
      "rollback": {
        "method": "PATCH",
        "url": "/REPLACE_WITH_TEST_RESOURCE/{resource_id}"
      }
    }
  ]
}
